{
  "firestore": {
    "rules": "firestore.rules"
  },
  "functions": { "source": "backend/scan-knowledge", "codebase": "default" },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "site": "domidex",
    "public": "dist/client",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {
        "source": "**",
        "run": {
          "serviceId": "domidex-web",
          "region": "europe-west1",
          "pinTag": true
        }
      }
    ]
  },
  "emulators": {
    "auth": { "port": 9099 },
    "firestore": { "port": 8080 },
    "storage": { "port": 9199 },
    "ui": { "enabled": false },
    "singleProjectMode": true
  }
}
