# Public Firebase Web SDK configuration. These values identify the Firebase app;
# authorization is enforced by Firebase Authentication and Firestore rules.
NEXT_PUBLIC_FIREBASE_API_KEY=replace-with-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=replace-with-project-number
NEXT_PUBLIC_FIREBASE_APP_ID=replace-with-web-app-id

# Set to the canonical deployment origin without a trailing slash.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_DISCORD_URL=
NEXT_PUBLIC_GITHUB_URL=https://github.com/nandedomi
NEXT_PUBLIC_KICKSTARTER_URL=

# Private local bootstrap values. Never expose these with NEXT_PUBLIC_.
DOMIDEX_ADMIN_UID=
GOOGLE_APPLICATION_CREDENTIALS=

# Ausschließlich lokale Scanner-Lab-Entwicklung. Diese Archive werden nie deployed.
DOMIDEX_SCANNER_REFERENCE_DIR=
DOMIDEX_TCGDEX_DB_PATH=
DOMIDEX_SCANNER_SOURCE_INDEX=
DOMIDEX_SCANNER_MASTER_INDEX_PATH=
